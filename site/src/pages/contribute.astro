---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CONTENT_CATEGORIES } from '../lib/contribution';

// Zero-JS contribution form. Native HTML validation (required / minlength /
// maxlength / pattern) runs client-side without a line of script; the server
// re-validates in functions/api/contributions.ts. Native form POST is
// application/x-www-form-urlencoded, which the endpoint answers with a 303 to a
// static outcome page (thanks / sign-in-required / error).
//
// IN THE NATIVE APP this page serves a hand-off instead of the forms, because the
// action is a RELATIVE /api/contributions: on the web that resolves to the Pages
// Function, but in the app the origin is capacitor://localhost, so the POST hits a
// route that isn't in the bundle. WikiRouter answers with the 404 page — a full
// navigation that throws away everything the reader typed.
//
// This used to be done by rewriting the bundled HTML after `cap copy`
// (app/tools/native-contribute.mjs, removed 2026-07-26). That made one URL have
// two different correct bodies, which is exactly what a content-hash OTA channel
// cannot express: the page is in the OTA manifest, so the first update whose bytes
// differed from the bundle's downloaded the WEB version over the hand-off and
// permanently reinstated the dead-end. See Phase 5.1 in docs/app-remediation-plan.md.
//
// Deciding at runtime keeps ONE artifact, so the bundle and the OTA payload can
// never disagree. Same gate as the install announcement in components/AppBanner.astro.
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<StarlightPage frontmatter={{ title: 'Contribute to the wiki', description: 'Suggest an edit or propose a new page. Contributions are pseudonymous and reviewed before publishing.' }}>
  <p>
    This wiki is community-built. You can suggest a change to an existing page or
    propose a new one. Contributions are <strong>pseudonymous</strong> and go to a
    moderation queue — a person reviews every submission before anything reaches
    the live site.
  </p>
  <p>
    Contributing requires a quick sign-in (so submissions can be moderated and, if
    you ask, removed later). Sign-in is rolling out — until it's live you'll be
    asked to come back.
  </p>

  {/*
    Runs before the forms below are parsed, so the swap happens without a frame of
    the wrong content. `is:inline` keeps it out of the bundle — a deferred module
    would paint the forms first.

    Fails toward the WEB on purpose: no flag set means the forms show. If this
    script somehow doesn't run, the website (the larger audience) still works, and
    the app degrades to the dead-end it had before — bad, but not a regression the
    website pays for. The app always has JS; Capacitor requires it.
  */}
  <script is:inline>
    if (
      (window.Capacitor &&
        typeof window.Capacitor.isNativePlatform === 'function' &&
        window.Capacitor.isNativePlatform()) ||
      location.protocol === 'capacitor:'
    ) {
      document.documentElement.dataset.dwNative = 'true';
    }
  </script>

  <div class="native-contribute" data-pagefind-ignore>
    <p>
      Contributions are submitted on the website. Open the contribute page in your
      browser to suggest an edit or propose a new page — you'll need a connection.
    </p>
    <a href="https://disabilitywiki.org/contribute/" rel="noopener">
      Open the contribute page →
    </a>
  </div>

  <form method="post" action="/api/contributions" class="contribute-form">
    <input type="hidden" name="kind" value="suggest_edit" />
    <fieldset>
      <legend><h2 id="suggest-an-edit">Suggest an edit</h2></legend>

      <label for="se-page">Page to edit</label>
      <input
        id="se-page"
        name="page"
        type="text"
        required
        inputmode="url"
        placeholder="/benefits/us/ssi/"
        pattern="/.*"
        aria-describedby="se-page-hint"
      />
      <small id="se-page-hint">The path of the page, e.g. <code>/benefits/us/ssi/</code>.</small>

      <label for="se-section">Section (optional)</label>
      <input id="se-section" name="section" type="text" maxlength="120" placeholder="Eligibility" />

      <label for="se-body">Your suggestion</label>
      <textarea id="se-body" name="body" required minlength="10" maxlength="20000" rows="6"
        placeholder="What should change, and why? Include a source if you have one."></textarea>

      <button type="submit">Submit suggested edit</button>
    </fieldset>
  </form>

  <form method="post" action="/api/contributions" class="contribute-form">
    <input type="hidden" name="kind" value="propose_page" />
    <fieldset>
      <legend><h2 id="propose-a-page">Propose a new page</h2></legend>

      <label for="pp-title">Title</label>
      <input id="pp-title" name="title" type="text" required maxlength="120" placeholder="Autistic burnout" />

      <label for="pp-category">Category</label>
      <select id="pp-category" name="category" required>
        <option value="" disabled selected>Choose a category…</option>
        {CONTENT_CATEGORIES.map((c) => <option value={c}>{cap(c)}</option>)}
      </select>

      <label for="pp-body">Draft</label>
      <textarea id="pp-body" name="body" required minlength="10" maxlength="20000" rows="8"
        placeholder="A first draft — plain language, with sources where you can."></textarea>

      <button type="submit">Submit proposed page</button>
    </fieldset>
  </form>
</StarlightPage>

<style>
  /* Web is the default: the hand-off is hidden until the native gate says otherwise.
     `:global()` because the flag lives on <html>, outside this component's scope —
     same idiom as the announcement rule in components/AppBanner.astro. */
  .native-contribute {
    display: none;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  :global([data-dw-native]) .native-contribute {
    display: block;
  }
  :global([data-dw-native]) .contribute-form {
    display: none;
  }
  .native-contribute p {
    margin-top: 0;
  }
  .native-contribute a {
    /* Flex-centred rather than the line-height:44px trick the old inline-styled
       card used: that gives every WRAPPED line a 44px box, so at narrow widths the
       label rendered as three widely-spaced lines in a 124px-wide button. This
       keeps the ≥44pt target from the padding and min-height, and still looks like
       a button when the text wraps. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px; /* ≥44pt touch target */
    padding: 0.6rem 1.4rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--sl-color-black);
    background: var(--sl-color-accent-high);
    border-radius: 0.4rem;
    text-decoration: none;
  }

  .contribute-form {
    margin: 2rem 0;
  }
  .contribute-form fieldset {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem 1.5rem;
  }
  .contribute-form legend h2 {
    margin: 0;
    padding: 0 0.5rem;
    font-size: 1.2rem;
  }
  .contribute-form label {
    display: block;
    margin-top: 1rem;
    font-weight: 600;
  }
  .contribute-form input,
  .contribute-form select,
  .contribute-form textarea {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.6rem 0.7rem;
    font-size: 1rem; /* ≥16px: no iOS focus-zoom */
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .contribute-form small {
    display: block;
    margin-top: 0.3rem;
    color: var(--sl-color-gray-3);
  }
  .contribute-form button {
    margin-top: 1.25rem;
    min-height: 44px;
    padding: 0.6rem 1.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-black);
    background: var(--sl-color-accent-high);
    border: none;
    border-radius: 0.4rem;
    cursor: pointer;
  }
  .contribute-form button:hover {
    background: var(--sl-color-accent);
  }
</style>
